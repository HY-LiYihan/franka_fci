# FR3 control cabinet FCI address on the robot-side industrial PC.
FRANKA_ROBOT_IP=172.16.0.2
FRANKA_ROBOT_MODEL=fr3
FRANKA_GRIPPER_ENABLED=true
# Calibrate these on the installed official gripper before Cartesian control.
# Format: JSON arrays, flange -> gripper, SI units / quaternion xyzw.
FRANKA_GRIPPER_FLANGE_TRANSLATION_M=[]
FRANKA_GRIPPER_FLANGE_QUATERNION_XYZW=[]

# Keep the API local until LAN deployment has been reviewed.
FRANKA_API_HOST=127.0.0.1
FRANKA_API_PORT=8000
FRANKA_STATE_STALE_AFTER_MS=250
FRANKA_MAX_MOTION_DURATION_S=30
FRANKA_ALLOWED_ORIGINS=
